# TokenTrim Backend - Environment Configuration (Vercel)

# Optional Supabase Database (if omitted, falls back to local demo in-memory/JSON store)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# HMAC secret for short-lived admin step-up tokens (REQUIRED in production, >=32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ACTION_SECRET=replace-me-with-64-hex-chars-min-32

# NOTE: SESSION_SECRET is deprecated and unused. Sessions are opaque random
# tokens (sha256-hashed at rest). Do not set it; it has no effect.

# Admin Frontend Origin for CORS (e.g. Netlify URL or custom domain)
ADMIN_ORIGIN=https://tokentrim-admin.netlify.app

# Optional initial creator/admin account bootstrap
ADMIN_EMAIL=creator@tokentrim.local
ADMIN_PASSWORD=creator-secure-pass!
ADMIN_PIN=482619

# Set to true during E2E testing to enable test-utils endpoints
ALLOW_TEST_ENDPOINTS=false
