# TokenTrim Admin & API Environment Configuration
# Copy this file to .env.local to enable Supabase production mode.

# Supabase Postgres credentials (both required to switch from demo JSON to Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Creator Admin Account (auto-seeded on first run if enabled)
ADMIN_EMAIL=admin@tokentrim.local
ADMIN_PASSWORD=admin123
ADMIN_PIN=1234
SEED_ADMIN=true

# HMAC secret for short-lived admin step-up tokens (REQUIRED in production, >=32 chars).
ADMIN_ACTION_SECRET=replace-me-with-64-hex-chars-min-32

# Demo store path (used only when Supabase credentials are not set)
# DEMO_DB_PATH=data/demo-db.json

# Test endpoints (/api/test-utils/*) - only for testing in demo mode
# ALLOW_TEST_ENDPOINTS=false
